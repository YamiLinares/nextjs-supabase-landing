# ---------------------------------------------------------------
# Plantilla de variables de entorno. Copia este archivo como
# .env.local y completa los valores de TU proyecto de Supabase:
#   Copy-Item .env.example .env.local
# .env.local está ignorado por Git: nunca lo subas al repositorio.
# ---------------------------------------------------------------

# URL del proyecto (Supabase Dashboard > Project Settings > API / Data API)
# Ejemplo de formato: https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PUBLICABLE (Project Settings > API Keys), formato sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alternativa para proyectos con claves heredadas: la clave "anon" (JWT).
# Usa una de las dos; si ambas existen, se prioriza la publicable.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: URL pública del sitio para metadatos Open Graph.
# En AWS Amplify debe configurarse a mano con el dominio que asigna Amplify,
# por ejemplo https://main.<id-de-la-app>.amplifyapp.com
# En Vercel se detecta automáticamente.
# NEXT_PUBLIC_SITE_URL=https://main.tu-app.amplifyapp.com
#
# En AWS Amplify, estas variables se configuran en
# Hosting > Environment variables (no en este archivo).

# NUNCA agregues aquí la clave service_role ni una clave sb_secret_...
